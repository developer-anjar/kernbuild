# EmailJS configuration (frontend-only)
# Copy this file to .env.local and fill in your values.
# Never commit real credentials to version control.

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_emailjs_contact_template_id
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=your_emailjs_feedback_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: business email shown in the footer
VITE_BUSINESS_EMAIL=hello@example.com
